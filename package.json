{
  "name": "ha-wled-card",
  "version": "0.1.0",
  "description": "A full-featured Lovelace card for WLED: segments, effects (with speed/intensity/palette), presets, playlists, and per-section visibility configuration.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "wled",
    "hacs"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.18.0",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.1.4"
  }
}
